{
  "name": "ipcorp-brain-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Stakeholder-safe Context OS frontend for the IP Corp Architecture Brain — readiness, prep packets, Cortex insights, gated actions, risks, ADRs, and source health.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5217",
    "sync:data": "node scripts/sync-data.mjs",
    "generate:graph": "npx tsx scripts/generate-brain-graph.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run test",
    "prepare": "simple-git-hooks || echo 'Git hooks setup skipped (optional)'"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint:fix && git add -u"
  },
  "dependencies": {
    "@liquid-dom/core": "^0.1.1",
    "@liquid-dom/react": "^0.1.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.0",
    "3d-force-graph": "^1.80.0",
    "force-graph": "^1.51.4",
    "framer-motion": "^12.23.24",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "three-spritetext": "^1.10.0",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.7.2"
  }
}
